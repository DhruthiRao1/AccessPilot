# --- Gemini on Vertex AI (Gemini Enterprise Agent Platform) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ACCESSPILOT_MODEL=gemini-2.5-flash

# --- Or use an AI Studio key instead of Vertex AI ---
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-key

# --- Database: sqlite (default, offline) or alloydb ---
ACCESSPILOT_DB=sqlite
# ACCESSPILOT_DB=alloydb
# ALLOYDB_DSN=postgresql://postgres:password@127.0.0.1:5432/accesspilot
# ALLOYDB_EMBEDDING_MODEL=text-embedding-005

# --- ServiceNow: leave empty to use the built-in mock ---
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

AUTO_APPROVE_MAX_COST=500
